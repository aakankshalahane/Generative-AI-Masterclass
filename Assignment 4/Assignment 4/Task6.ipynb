   "source": [
    "# Task 6: Read File Safely\n",
    "import os\n",
    "\n",
    "filename = input(\"Enter filename: \")\n",
    "\n",
    "if os.path.exists(filename):\n",
    "    with open(filename, \"r\") as f:\n",
    "        print(f.read())\n",
    "else:\n",
    "    print(\"File not found. Please check the filename.\")\n"
   ]
  }
